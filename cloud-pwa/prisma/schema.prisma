generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Ak používate Prisma Accelerate (prisma+postgres://), url musí byť táto:
  url       = env("PRISMA_DATABASE_URL") 
  // Direct URL musí byť klasická postgres:// adresa pre priame migrácie
  directUrl = env("POSTGRES_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("OPERATOR")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) // Zjednotené
  updatedAt     DateTime @updatedAt      // Zjednotené
}

model Store {
  id              String   @id @default(uuid())
  name            String
  url             String
  consumer_key    String
  consumer_secret String
  api_key         String?  
  orders          Order[]
  createdAt      DateTime @default(now()) // Opravené na createdAt
}

model Order {
  id            String      @id @default(uuid())
  woo_id        Int         
  store_id      String
  store         Store       @relation(fields: [store_id], references: [id], onDelete: Cascade)
  customer_name String
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now()) // Opravené na createdAt
  updatedAt     DateTime    @updatedAt      // Opravené na updatedAt
  items         OrderItem[]

  @@unique([woo_id, store_id])
}

model OrderItem {
  id               String          @id @default(uuid())
  order_id         String
  order            Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  woo_item_id      Int
  product_name_raw String
  template_key     String?
  template         TemplateConfig? @relation(fields: [template_key], references: [key])
  source_text      String? 
  ai_data          String? 
  preview_url      String?
  agent_log        String?
  material         String?
  quantity         Int             @default(1)
  status           String          @default("PENDING")
  sku              String?
  format           String?
  product_metadata_id String?
  product_metadata    ProductMetadata? @relation(fields: [product_metadata_id], references: [id])
}

model TemplateConfig {
  key                 String           @id 
  name                String? 
  manifest            String? 
  mappings            String? 
  folder_path         String? 
  main_file           String? 
  files               String? 
  status              String           @default("NEW") 
  is_in_eshop         Boolean          @default(false) 
  is_verified         Boolean          @default(false)
  pricing_json        String? 
  image_url           String?
  sku                 String?
  product_metadata_id String?
  product_metadata    ProductMetadata? @relation(fields: [product_metadata_id], references: [id])
  last_synced_at      DateTime? 
  createdAt           DateTime         @default(now()) // Opravené na createdAt
  order_items         OrderItem[]
}

model ProductMetadata {
  id           String           @id @default(uuid())
  csv_title    String
  pricing_json String? 
  image_url    String?
  html_content String? 
  source_csv   String? 
  sku          String? 
  order_items  OrderItem[]
  templates    TemplateConfig[]
  createdAt    DateTime         @default(now()) // Opravené na createdAt
}

model Settings {
  key   String @id
  value String
}

model Job {
  id            String   @id @default(uuid())
  type          String   
  status        String   @default("PENDING") 
  payload       String?  
  result_path   String?  
  error_message String?  
  createdAt     DateTime @default(now()) // Opravené na createdAt
  updatedAt     DateTime @updatedAt      // Opravené na updatedAt
  
  woo_id        Int?
  template_key  String?
}